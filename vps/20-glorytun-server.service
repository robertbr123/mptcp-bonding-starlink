# vps/20-glorytun-server.service -> /etc/systemd/system/glorytun-server.service
# glorytun moderno: multipath UDP nativo (não usa MPTCP do kernel).
# Servidor escuta em UDP 65001 e cria o tun0 (o IP é configurado pelo ExecStartPost).
[Unit]
Description=glorytun server (bonding Starlink, multipath UDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/glorytun bind dev tun0 keyfile /etc/glorytun/tunnel.key from addr 0.0.0.0 port 65001 persist
ExecStartPost=/bin/sh -c 'for i in $(seq 1 10); do ip link show tun0 >/dev/null 2>&1 && break; sleep 1; done; ip addr add 10.255.255.1 peer 10.255.255.2 dev tun0 2>/dev/null || true; ip link set tun0 up mtu 1400'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
