# router/80-glorytun-watchdog.timer -> /etc/systemd/system/glorytun-watchdog.timer
# Roda o watchdog a cada 15s (e 30s após o boot) — recuperação rápida se o túnel cair.
[Unit]
Description=verifica o tunel glorytun a cada 15s

[Timer]
OnBootSec=30
OnUnitActiveSec=15
AccuracySec=2s

[Install]
WantedBy=timers.target
